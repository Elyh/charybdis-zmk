#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y
                &kp U      &kp I      &kp O      &kp P      &kp LBKT   &kp RBKT

                &kp A      &kp S      &kp D      &kp F      &kp G      &kp H
                &kp J      &kp K      &kp L      &kp SEMI   &kp SQT    &kp BSLH

                &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N
                &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp MINUS  &kp EQUAL

                &kp LCTRL  &kp LALT   &kp LSHIFT  &kp LGUI   &kp TAB    &kp SPACE
                &kp RET    &kp BSPC   &kp RGUI    &kp RSHIFT &kp RALT   &kp RCTRL

                &kp LALT   &kp SPACE  &kp TAB     &kp LCTRL
                &kp RET    &kp BSPC   &kp RCTRL   &kp RALT
            >;
        };
    };
};
